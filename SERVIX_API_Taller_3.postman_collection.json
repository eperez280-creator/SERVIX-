  "item": [
    {
      "name": "01 - Health / estado de la API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health",
        "auth": {
          "type": "noauth"
        },
        "description": "Endpoint publico para verificar que el servidor esta activo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"La respuesta es correcta\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test(\"La API responde JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Registrar solicitante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Camila Solano (solicitante demo)\",\n  \"correoElectronico\": \"{{emailSolicitante}}\",\n  \"telefono\": \"3001234567\",\n  \"contrasena\": \"{{contrasenaDemo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Crea un correo unico en cada ejecucion de la coleccion. Guarda el token e ID para los siguientes requests."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailSolicitante\", \"solicitante.\" + Date.now() + \".\" + Math.random().toString(36).slice(2, 7) + \"@servix.test\");",
              "pm.collectionVariables.set(\"contrasenaDemo\", \"ServixDemo2026!\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"La cuenta se crea con HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"tokenSolicitante\", json.data.token);",
              "pm.collectionVariables.set(\"idSolicitante\", json.data.usuario.id);",
              "pm.test(\"La respuesta no expone el hash de la contrasena\", function () { pm.expect(json.data.usuario.passwordHash).to.be.undefined; });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Registrar trabajador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Mateo Rojas (trabajador demo)\",\n  \"correoElectronico\": \"{{emailTrabajador}}\",\n  \"telefono\": \"3101234567\",\n  \"contrasena\": \"{{contrasenaDemo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "SERVIX conserva una cuenta comun: el mismo usuario puede solicitar y prestar servicios segun la accion."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailTrabajador\", \"trabajador.\" + Date.now() + \".\" + Math.random().toString(36).slice(2, 7) + \"@servix.test\");",
              "pm.collectionVariables.set(\"contrasenaDemo\", pm.collectionVariables.get(\"contrasenaDemo\") || \"ServixDemo2026!\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"La cuenta se crea con HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"tokenTrabajador\", json.data.token);",
              "pm.collectionVariables.set(\"idTrabajador\", json.data.usuario.id);",
              "pm.test(\"La cuenta inicia pendiente de verificacion\", function () { pm.expect(json.data.usuario.estadoVerificacion).to.eql(\"PENDIENTE\"); });"
            ]
          }
        }
      ]
    },
