        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Pintar una habitacion\",\n  \"descripcion\": \"Necesito pintar una habitacion de aproximadamente 12 metros cuadrados. La pared ya esta preparada.\",\n  \"categoria\": \"Pintura y mantenimiento\",\n  \"precio\": 180000,\n  \"fecha\": \"2027-12-01\",\n  \"hora\": \"09:00\",\n  \"ciudad\": \"Bogota\",\n  \"zona\": \"Suba\",\n  \"direccionReferencia\": \"Referencia privada: cerca de la plaza principal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "La fecha de prueba se deja en el futuro. El identificador se guarda automaticamente para usarlo en el resto de la coleccion."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"La solicitud se publica con HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"solicitudId\", json.data.solicitud.id);",
              "pm.test(\"El estado inicial es PUBLICADO\", function () { pm.expect(json.data.solicitud.estado).to.eql(\"PUBLICADO\"); });"
            ]
          }
        }
      ]
    },
